<h1>Chat</h1>
<div class="container">


  <%# mensaje IA %>
  <div id="messages" class="pb-5 mb-5">
    <% @chat.messages.each do |message| %>
      <% if message.role == "user" %>
        <div class="d-flex justify-content-end mb-2">
          <div class="bg-white px-3 pb-0 pt-3 rounded-pill">
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% elsif message.role == "assistant" %>
        <div class="d-flex justify-content-start mb-5">
          <div class="ia-message px-3 pb-0 pt-3 rounded-5 mb-5">
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
  <div id="new_message_container" class="position-fixed bottom-0 start-0 end-0">
    <div class="container bg-white rounded-5 pt-4 pb-2">
      <%= simple_form_for [@chat, @message] do |f| %>
        <%= f.input :content, label: false, required: true, placeholder: "Escribe tu plan" %>
        <%= f.button :submit, '>', class: 'btn btn-primary rounded-5' %>
      <% end %>
    </div>
  </div>
</div>
