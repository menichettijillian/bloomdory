<div class="container-fluid my-4 px-4">

  <%# Barra superior con título y botón para regresar al calendario %>
  <div class="calendar-top-bar mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="d-flex align-items-center gap-3">
      <%= image_tag "Bloomy-13.png", alt: "Bloomdory Flower", style: "width: 90px; height: 90px; object-fit: contain;" %>
      <div>
        <h1 class="fw-bold text-dark mb-1 fs-2">Mis Objetivos</h1>
        <p class="text-muted mb-0">Define, visualiza y alcanza tus metas personales y profesionales.</p>
      </div>
    </div>

    <div>
      <%= link_to schedules_path, class: "btn btn-outline-primary rounded-pill px-4 d-flex align-items-center gap-2" do %>
        <i class="bi bi-calendar-week"></i> Volver a mi semana
      <% end %>
    </div>
  </div>

  <%# Contenedor principal de objetivos con fondo azul clarito %>
  <div class="row">
    <div class="col-12">
      <div class="calendar-main-container p-4 rounded-4 shadow-sm border-0" style="background-color: #f0f4ff;">

        <div class="d-flex justify-content-between align-items-center mb-4">
          <h3 class="fw-bold text-dark mb-0 fs-4">Metas Activas</h3>

          <%# Botón Nuevo objetivo redirige a construcción %>
          <%= link_to construction_path, class: "btn btn-primary rounded-pill px-3 py-2 shadow-sm text-decoration-none d-flex align-items-center gap-2" do %>
            <i class="bi bi-plus-lg"></i> Nuevo objetivo
          <% end %>
        </div>

        <%# Cuadrícula de objetivos %>
        <div class="row g-4 mb-4">

          <%# Tarjeta de ejemplo 1 %>
          <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-3 h-100 bg-white">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">Proyecto</span>
                <span class="text-muted small">75% completado</span>
              </div>
              <h5 class="fw-bold text-dark mt-2">Avanzar en Bloomdory</h5>
              <p class="text-muted small mb-4">Terminar la interfaz de vistas y organizar el calendario semanal con Stimulus.</p>

              <div class="progress mb-3" style="height: 6px;">
                <div class="progress-bar bg-primary rounded-pill" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
              </div>

              <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                <span class="text-muted small"><i class="bi bi-clock me-1"></i> Vence: Septiembre 2026</span>

                <%# Botón de tres puntos redirige a construcción %>
                <%= link_to construction_path, class: "btn btn-sm btn-light text-primary rounded-circle text-decoration-none d-flex align-items-center justify-content-center", style: "width: 32px; height: 32px;" do %>
                  <i class="bi bi-three-dots-vertical"></i>
                <% end %>
              </div>
            </div>
          </div>

          <%# Tarjeta de ejemplo 2 %>
          <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-3 h-100 bg-white">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Bienestar</span>
                <span class="text-muted small">30% completado</span>
              </div>
              <h5 class="fw-bold text-dark mt-2">Leer 12 libros al año</h5>
              <p class="text-muted small mb-4">Mantener el hábito de lectura diaria antes de dormir para mejorar la concentración.</p>

              <div class="progress mb-3" style="height: 6px;">
                <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: 30%;" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100"></div>
              </div>

              <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                <span class="text-muted small"><i class="bi bi-clock me-1"></i> Vence: Diciembre 2026</span>

                <%# Botón de tres puntos redirige a construcción %>
                <%= link_to construction_path, class: "btn btn-sm btn-light text-success rounded-circle text-decoration-none d-flex align-items-center justify-content-center", style: "width: 32px; height: 32px;" do %>
                  <i class="bi bi-three-dots-vertical"></i>
                <% end %>
              </div>
            </div>
          </div>

          <%# Tarjeta para añadir uno nuevo  %>
          <div class="col-md-4">
            <%= link_to construction_path, class: "text-decoration-none h-100 d-block" do %>
              <div class="card border-2 border-dashed rounded-4 p-4 h-100 bg-transparent d-flex align-items-center justify-content-center text-center" style="border-style: dashed !important; border-color: #cbd5e1 !important; min-height: 200px;">
                <div class="text-muted">
                  <i class="bi bi-plus-circle fs-2 text-primary mb-2 d-block"></i>
                  <span class="fw-semibold text-dark">Añadir un nuevo objetivo</span>
                  <p class="small text-muted mb-0">Haz clic aquí para plantear una nueva meta.</p>
                </div>
              </div>
            <% end %>
          </div>

        </div>

        <%# bloomy abajo%>
        <div class="text-center mt-5 mb-2">
          <%= image_tag "Bloomy-12.png", alt: "Bloomdory Decorativa", style: "width: 140px; height: 140px; object-fit: contain;" %>
        </div>

      </div>
    </div>
  </div>

</div>
