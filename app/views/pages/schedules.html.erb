<div class="container my-5">

<%# Nav bar %>
  <div class="calendar-top-bar mb-4">
    <div>
      <h2 class="fw-bold text-dark mb-1">Tu semana organizada</h2>
      <p class="text-muted mb-0">Visualiza y administra tus actividades de la semana.</p>
    </div>
    <div class="d-flex align-items-center gap-3">
      <div class="date-navigator bg-white px-3 py-2 rounded-pill shadow-sm border d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-light rounded-circle"><i class="bi bi-chevron-left"></i></button>
        <%# Para mostrar el rango real calculado en el controlador  %>
        <span class="fw-semibold text-secondary small"><%= @week_range_text %></span>
        <button class="btn btn-sm btn-light rounded-circle"><i class="bi bi-chevron-right"></i></button>
      </div>
      <%= link_to "← Dashboard", dashboard_path, class: "btn btn-outline-primary rounded-pill px-3" %>
    </div>
  </div>

<%# Contenedor del calendario %>
  <div class="calendar-main-container bg-white p-4 rounded-4 shadow-sm border-0">

    <div class="calendar-month-grid">

      <!-- Iteramos los días reales calculados por Ruby -->
      <% @week_days.each do |day_info| %>
        <div class="calendar-day-column p-2 rounded-3">

<%# Encabezado del d[ia] %>
          <div class="text-center pb-2 mb-2 border-bottom">
            <span class="d-block text-muted fw-bold text-uppercase" style="font-size: 0.7rem;"><%= day_info[:name] %></span>
            <span class="d-block fw-bold text-dark fs-6 mt-1"><%= day_info[:num] %></span>
          </div>

<%# filtro %>
          <% day_schedules = @schedules.select { |s| s.starting_date&.to_date == day_info[:date] } %>

          <% if day_schedules.present? %>
            <% day_schedules.each do |schedule| %>
              <div class="event-card-bloom p-2 mb-2 rounded-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="badge bg-light text-primary fw-bold" style="font-size: 0.65rem;">
                    <%= schedule.starting_hour&.strftime("%I:%M %p") %>
                  </span>
                </div>
                <div class="fw-bold text-dark" style="font-size: 0.8rem;"><%= schedule.title %></div>
                <% if schedule.category.present? %>
                  <small class="text-muted d-block mt-1" style="font-size: 0.7rem;"><%= schedule.category %></small>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="text-center text-muted py-4 small" style="font-size: 0.75rem; opacity: 0.5;">Sin eventos</div>
          <% end %>

        </div>
      <% end %>
    </div>

  </div>
</div>

<style>
  body {
    background-color: #f4f7fc;
  }

  .calendar-top-bar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
  }

  .calendar-month-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 12px;
  }

  .calendar-day-column {
    background-color: #fafbfd;
    border: 1px solid #edf2f7;
    min-height: 450px;
  }

  .event-card-bloom {
    background-color: #eef4ff;
    border-left: 3px solid #3b82f6;
    transition: transform 0.15s ease;
  }

  .event-card-bloom:hover {
    transform: translateY(-2px);
  }
</style>
