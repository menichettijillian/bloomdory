

<div class="d-flex dashboard-workspace">
  <!-- PANEL IZQUIERDO (SIDEBAR) -->
  <div class="bg-light p-3 border-end d-flex flex-column dashboard-sidebar" style="width: 280px; flex-shrink: 0;">

    <!-- Botón Mi Semana -->
    <%= link_to my_week_path, class: "btn btn-outline-primary w-100 mb-3 text-start" do %>
      <i class="bi bi-calendar-event me-2"></i> Mi Semana
    <% end %>

    <%# # Botón Nuevo Chat %>
    <%= button_to "+ Nuevo Chat",
              chats_path,
              method: :post,
              class: "btn btn-dark w-100 mb-3 text-start" %>

    <hr>

    <!-- Historial de Chats -->
    <h6 class="text-muted small text-uppercase">Tus Chats</h6>
    <div class="flex-grow-1 overflow-auto">
      <ul class="list-unstyled">
        <% if @chats.present? %>
          <% @chats.each do |chat| %>
            <li class="mb-1 d-flex align-items-center">
              <%= link_to dashboard_path(chat_id: chat.id),
                          class: "flex-grow-1 text-decoration-none d-block p-2 rounded #{chat == @chat ? 'bg-dark text-white' : 'text-dark'}" do %>
                <div class="chat-history-title">
                  <%= chat.title.presence || "Conversación ##{chat.id}" %>
                </div>

                <small class="<%= chat == @chat ? 'text-white-50' : 'text-muted' %>">
                  <%= chat.created_at.strftime("%d/%m/%Y · %H:%M") %>
                </small>
              <% end %>

              <%= button_to chat_path(chat),
                            method: :delete,
                            class: "btn btn-sm text-danger ms-1",
                            form: {
                              data: {
                                turbo_confirm: "¿Seguro que quieres eliminar esta conversación?"
                              }
                            },
                            aria: {
                              label: "Eliminar #{chat.title.presence || 'conversación'}"
                            } do %>
                <i class="fa-solid fa-trash"></i>
              <% end %>
            </li>
          <% end %>
        <% else %>
          <li class="text-muted small p-2">Aún no tienes chats.</li>
        <% end %>
      </ul>
    </div>
  </div>


  <%# # panel derecho %>
  <div class="flex-grow-1 bg-white p-4 dashboard-main">
    <% if @chat %>
      <%= render "chats/chat", chat: @chat, message: @message %>
    <% else %>
      <div class="h-100 d-flex align-items-center justify-content-center">
        <div class="text-center">
          <h2>¿Cómo quieres organizar tu semana?</h2>
          <p>Inicia una conversación para preparar tu próximo plan.</p>
        </div>
      </div>
    <% end %>
  </div>
</div>
