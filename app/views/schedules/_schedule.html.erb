<div class="event-card-bloom p-2 mb-2 rounded-3 shadow-sm position-relative" data-id="<%= schedule.id %>">
  <%# caja%>
  <div class="d-flex justify-content-between align-items-center mb-1">
    <span class="badge bg-light text-primary fw-bold" style="font-size: 0.65rem;">
      <%= schedule.starting_hour&.strftime("%I:%M %p") %>
      <% if schedule.respond_to?(:ending_hour) && schedule.ending_hour.present? %>
        - <%= schedule.ending_hour.strftime("%I:%M %p") %>
      <% end %>
    </span>

    <%# Botones editar / eliminar %>
    <div class="d-flex gap-1">
      <%= link_to edit_schedule_path(schedule), class: "text-muted text-decoration-none p-0 me-1", title: "Editar", style: "font-size: 0.75rem;" do %>
        <i class="bi bi-pencil-square"></i>
      <% end %>

      <%# Botón para activar el modal de Bootstrap en lugar del confirm nativo %>
      <%= link_to "#",
                  class: "text-danger text-decoration-none p-0",
                  title: "Eliminar",
                  style: "font-size: 0.75rem;",
                  data: {
                    bs_toggle: "modal",
                    bs_target: "#deleteConfirmationModal",
                    bs_schedule_title: schedule.title,
                    bs_schedule_path: schedule_path(schedule)
                  } do %>
        <i class="bi bi-trash"></i>
      <% end %>
    </div>
  </div>

  <div class="fw-bold text-dark" style="font-size: 0.8rem;"><%= schedule.title %></div>
  <% if schedule.category.present? %>
    <small class="text-muted d-block mt-1" style="font-size: 0.75rem;"><%= schedule.category %></small>
  <% end %>
</div>
