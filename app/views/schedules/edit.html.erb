<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <%# Tarjeta principal con estilo moderno y elegante %>
      <div class="card border-0 shadow-lg rounded-5 p-4 p-md-5 bloom-edit-card position-relative overflow-hidden">

        <%# Detalle decorativo superior (barra de acento) %>
        <div class="position-absolute top-0 start-0 end-0 bg-gradient-primary" style="height: 6px;"></div>

        <%# Personaje Bloomdory en la parte superior %>
        <div class="text-center mb-3">
          <%= image_tag "Bloomy-12.png", alt: "Bloomy", class: "img-fluid bloom-character-img mb-2", style: "max-height: 120px;" %>
          <h2 class="fw-bold text-dark mb-1" style="font-size: 1.5rem;">Ajustar manecillas del evento</h2>
          <p class="text-muted small mb-0">Modifica los detalles de tu actividad para mantener tu día organizado.</p>
        </div>

        <%= form_with(model: @schedule, local: true) do |f| %>
          <div class="mb-3">
            <%= f.label :title, "Título del evento", class: "form-label fw-bold small text-secondary" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-muted">
                <i class="bi bi-pencil"></i>
              </span>
              <%= f.text_field :title, class: "form-control bg-light border-start-0 rounded-end-pill py-2 px-3 shadow-none", placeholder: "Ej. Estudiar Ruby on Rails" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :category, "Categoría", class: "form-label fw-bold small text-secondary" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-muted">
                <i class="bi bi-tag"></i>
              </span>
              <%= f.text_field :category, class: "form-control bg-light border-start-0 rounded-end-pill py-2 px-3 shadow-none", placeholder: "Ej. Estudio, Trabajo, Personal" %>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :starting_date, "Fecha", class: "form-label fw-bold small text-secondary" %>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-muted">
                  <i class="bi bi-calendar-event"></i>
                </span>
                <%= f.date_field :starting_date, class: "form-control bg-light border-start-0 rounded-end-pill py-2 px-3 shadow-none" %>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <%= f.label :starting_hour, "Hora", class: "form-label fw-bold small text-secondary" %>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-muted">
                  <i class="bi bi-alarm"></i>
                </span>
                <%= f.time_field :starting_hour, class: "form-control bg-light border-start-0 rounded-end-pill py-2 px-3 shadow-none" %>
              </div>
            </div>
          </div>

          <div class="d-flex align-items-center justify-content-between mt-4 pt-3 border-top">
            <%= link_to schedules_path, class: "btn btn-light rounded-pill px-4 text-muted fw-semibold border" do %>
              <i class="bi bi-arrow-left me-1"></i> Cancelar
            <% end %>

            <%= f.submit "Guardar Cambios", class: "btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
